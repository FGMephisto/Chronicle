<root>
	<windowclass name="charsheet_actions">
		<script>
			function onInit()
				self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
			end
			function onLockModeChanged(bReadOnly)
				local tFields = { "weapons_iadd", };
				WindowManager.callSafeControlsSetVisible(self, tFields, not bReadOnly);
			end
			function onDrop(x, y, draginfo)
				if content.subwindow.weapons.onDrop(x, y, draginfo) then
					return true;
				end
				return false;
			end
		</script>
		<sheetdata>
			<anchor_content_top />
			<anchor_content_bottom />

			<area_content_framed_groupbox_bottom name="area_controls">
				<anchored height="20" />
			</area_content_framed_groupbox_bottom>
			<buttoncontrol name="weapons_iadd">
				<anchored to="area_controls" position="insidetopright" offset="0,0" width="20" height="20" />
				<icon normal="button_weapon" pressed="button_weapon_down" />
				<tooltip textres="char_tooltip_actionaddweapon" />
				<script>
					function onButtonPress()
						window.content.subwindow.weapons.addEntry(true);
					end
				</script>
			</buttoncontrol>
			<button_stringcycler name="powermode">
				<anchored to="area_controls" position="insidetopleft" offset="0,0" width="80" />
				<parameters>
					<labelsres>power_label_modecombat</labelsres>
					<values>combat</values>
					<defaultlabelres>power_label_modestd</defaultlabelres>
				</parameters>
				<script>
					function onValueChanged()
						window.content.subwindow.onModeChanged();
					end
				</script>
			</button_stringcycler>

			<sub_content_framed_groupbox name="content">
				<class>charsheet_actions_contents</class>
			</sub_content_framed_groupbox>
			<scrollbar_content />
		</sheetdata>
	</windowclass>

	<windowclass name="charsheet_actions_contents">
		<margins control="0,0,0,2" />
		<script>
			function onModeChanged()
				weapons.onModeChanged();
			end
		</script>
		<sheetdata>
			<anchor_content_top />

			<sub_content_top name="health">
				<class>charsheet_actions_health</class>
			</sub_content_top>
			<sub_content_top name="combat">
				<class>charsheet_actions_combat</class>
			</sub_content_top>
			<sub_content_top name="dice">
				<class>charsheet_actions_dice</class>
			</sub_content_top>

			<label_charframetop name="weapon_header">
				<anchored to="contentanchor" height="20">
					<top relation="relative" offset="8" postoffset="8" />
					<left offset="10" />
					<right offset="-10" />
				</anchored>
				<icons>char_attacks</icons>
				<static textres="char_title_weapons" />
			</label_charframetop>

			<button_details name="weapons_global_detail">
				<anchored to="weapon_header" position="insidetopright" offset="5,0" />
				<script>
					function onButtonPress()
						Interface.openWindow("char_weaponmeta", window.getDatabaseNode());
					end
				</script>
			</button_details>

			<list_charweapon name="weapons">
				<anchored>
					<top parent="weapon_header" anchor="bottom" relation="relative" offset="2" />
					<left offset="10" />
					<right offset="-5" />
				</anchored>
				<class>char_weapon</class>
				<noscroll />
			</list_charweapon>
		</sheetdata>
	</windowclass>

	<windowclass name="charsheet_actions_health">
		<sheetdata>
			<anchor_content_top />

			<label_charframetop name="header">
				<anchored to="contentanchor" height="20">
					<top relation="relative" offset="2" postoffset="2" />
					<left offset="10" />
					<right offset="-10" />
				</anchored>
				<icons>char_background</icons>
				<static textres="char_title_health" />
			</label_charframetop>

			<area_content_top name="health_row">
				<anchored height="50" />
			</area_content_top>

			<genericcontrol name="hp_icon">
				<anchored to="health_row" position="insidetopleft" offset="15,10" width="30" height="30" />
				<icon>char_health</icon>
				<tooltip textres="char_tooltip_hp" />
			</genericcontrol>
			<number_charwounds name="hp" source="hp.total">
				<anchored to="hp_icon" position="righthigh" offset="10,0" width="30" height="30" />
			</number_charwounds>

			<genericcontrol name="dmg_icon">
				<anchored to="hp" position="righthigh" offset="15,0" width="30" height="30" />
				<icon>char_damage</icon>
				<tooltip textres="char_tooltip_dmg" />
			</genericcontrol>
			<!-- For compatibility reasons with 5E we keep "wounds" when damage is meant. Ruleset specific "wounds" are handled via "trauma" -->
			<basicnumber name="dmg" source="hp.wounds">
				<anchored to="dmg_icon" position="righthigh" offset="10,0" width="30" height="30" />
				<min value="0" />
			</basicnumber>

			<genericcontrol name="injuries_icon">
				<anchored to="dmg" position="righthigh" offset="15,0" width="30" height="30" />
				<icon>char_injuries</icon>
				<tooltip textres="char_tooltip_injuries" />
			</genericcontrol>
			<number_charinjuries name="injuries" source="hp.injuries">
				<anchored to="injuries_icon" position="righthigh" offset="10,0" width="30" height="30" />
				<min value="0" />
			</number_charinjuries>

			<genericcontrol name="trauma_icon">
				<anchored to="injuries" position="righthigh" offset="15,0" width="30" height="30" />
				<icon>char_trauma</icon>
				<tooltip textres="char_tooltip_trauma" />
			</genericcontrol>
			<!-- For compatibility reasons with 5E we keep "wounds" when damage is meant. Ruleset specific "wounds" are handled via "trauma" -->
			<number_chartrauma name="trauma" source="hp.trauma">
				<anchored to="trauma_icon" position="righthigh" offset="10,0" width="30" height="30" />
				<min value="0" />
			</number_chartrauma>

			<genericcontrol name="fatigue_icon">
				<anchored to="trauma" position="righthigh" offset="15,0" width="30" height="30" />
				<icon>char_fatigue</icon>
				<tooltip textres="char_tooltip_fatigue" />
			</genericcontrol>
			<basicnumber name="fatigue" source="hp.fatigue">
				<anchored to="fatigue_icon" position="righthigh" offset="10,0" width="30" height="30" />
				<min value="0" />
			</basicnumber>
		</sheetdata>
