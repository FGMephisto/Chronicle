	<windowclass name="npc_combat_top">
		<margins control="0,0,0,2" />
		<script file="campaign/scripts/npc_main_top.lua" />
		<sheetdata>
			<hn name="dexterity" source="abilities.dexterity.score">
				<default>10</default>
				<script>
					function onValueChanged()
						window.onInitChanged();
					end
				</script>
			</hn>
			<hn name="initmiscmod" source="initiative.misc">
				<script>
					function onValueChanged()
						window.onInitChanged();
					end
				</script>
			</hn>

			<anchor_content_top />

			<sub_content_hidden_top name="sub_summary_fields">
				<class>npc_combat_summary_fields</class>
			</sub_content_hidden_top>
			<summary_content_column name="summary" />

			<line_content_top />

			<label_content_column name="ac_label">
				<static textres="armorclass" />
			</label_content_column>
			<number_content_column name="ac" />

			<label_content_column_right name="initmod_label">
				<anchored to="ac" />
				<static textres="npc_label_init" />
			</label_content_column_right>
			<numberc_npc_initmod_2024 name="initmod">
				<anchored to="ac" />
			</numberc_npc_initmod_2024>

			<label_content_column name="hp_label">
				<static textres="hitpoints" />
			</label_content_column>
			<number_content_column name="hp" />
			<string_content_column_remainder name="hd">
				<anchored to="hp" />
				<delaykeyupdate />
			</string_content_column_remainder>

			<label_content_column name="damagethreshold_label">
				<static textres="npc_label_damagethreshold" />
				<tooltip textres="npc_tooltip_damagethreshold" />
			</label_content_column>
			<number_content_columnh name="damagethreshold" />

			<label_content_column name="speed_label">
				<static textres="npc_label_speed" />
			</label_content_column>
			<string_content_column name="speed" />

			<line_content_top />
		</sheetdata>
	</windowclass>

