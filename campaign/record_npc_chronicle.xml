	<windowclass name="npc_notes">
		<script>
			function update()
				local node = getDatabaseNode();
				local bReadOnly = WindowManager.getReadOnlyState(node);
				local sRecordType = WindowManager.getRecordType(self);
				local bID = RecordDataManager.getIDState(sRecordType, node);

				local tFields = { "habitat", "treasure", "text", };
				WindowManager.callSafeControlsUpdate(self, tFields, bReadOnly, not bID);
			end
		</script>
		<sheetdata>
			<anchor_content_top />

			<label_content_column name="habitat_label">
				<static textres="npc_label_habitat" />
			</label_content_column>
			<string_content_columnh name="habitat" />

			<label_content_column name="treasure_label">
				<static textres="npc_label_treasure" />
			</label_content_column>
			<string_content_columnh name="treasure" />

			<ft_content_noframe_noscroll_top name="text" />
		</sheetdata>
	</windowclass>

