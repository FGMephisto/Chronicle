<root>
	<windowclass name="npc" copy="record_window_tabbed">
		<sizelimits>
			<minimum width="500" height="500" />
		</sizelimits>
		<minimize>minimized_npc</minimize>
		<gmexport>npc</gmexport>
		<!-- <tab> -->
			<!-- <name>main</name> -->
			<!-- <resource>tab_main</resource> -->
			<!-- <class>npc_combat</class> -->
			<!-- <embed /> -->
		<!-- </tab> -->
		<tab merge="add">
			<name>skills</name>
			<resource>tab_skills</resource>
			<class>npcsheet_skills</class>
			<embed />
		</tab>
		<tab merge="add">
			<name>abilities</name>
			<resource>tab_abilities</resource>
			<class>charsheet_abilities</class>
			<embed />
		</tab>
		<tab merge="add">
			<name>inventory</name>
			<resource>tab_inventory</resource>
			<class>charsheet_inventory</class>
			<embed />
		</tab>
		<tab merge="add">
			<name>actions</name>
			<resource>tab_actions</resource>
			<class>charsheet_actions</class>
			<embed />
		</tab>
		<tab merge="add">
			<name>notes</name>
			<resource>tab_notes</resource>
			<class>npc_notes</class>
			<embed />
		</tab>
		<tab merge="add">
			<name>pictures</name>
			<resource>tab_pictures</resource>
			<class>record_content_pictures</class>
			<embed />
		</tab>
		<script>
			function onIDChanged()
				super.onIDChanged();
				if not Session.IsHost then
					local bID = LibraryData.getIDState("npc", getDatabaseNode(), true);
					tabs.setVisible(bID);
					sub_version.setVisible(bID);
				end
			end
		</script>
	</windowclass>

	<!-- Adjusted -->
	<windowclass name="npc_combat">
		<margins control="0,0,0,2" />
		<script file="campaign/scripts/npc_main_chronicle.lua" />
		<sheetdata>
			<anchor_content_top />

			<sub_content_column name="sub_top">
