<root>
	<windowclass name="charsheet_skills">
		<script>
			function onDrop(x, y, draginfo)
				if draginfo.isType("shortcut") then
					local sClass = draginfo.getShortcutData();
					if sClass == "reference_skill" then
						content.subwindow.list.addSkillReference(draginfo.getDatabaseNode());
					end
					return true;
				end
			end
		</script>
		<sheetdata>
			<anchor_content_top />
			<anchor_content_bottom />

			<sub_content_framed_groupbox name="content">
				<class>charsheet_skills_contents</class>
			</sub_content_framed_groupbox>
			<scrollbar_content />
		</sheetdata>
	</windowclass>

 	<windowclass name="charsheet_skills_contents">
		<margins control="0,0,0,2" />
		<script>
			function onInit()
				self.onLockModeChanged(WindowManager.getWindowReadOnlyState(self));
			end
			function onLockModeChanged(bReadOnly)
				WindowManager.callSafeControlsSetLockMode(self, { "list_iadd", "idelete_header", }, bReadOnly);
			end
		</script>
		<sheetdata>
			<anchor_content_top />
			<anchor_content_bottom />

			<area_list_content_controls name="area_controls" />
			<anchor_list_content_controls_right name="rightanchor" />
			<filter_list_content_controls>
				<delaykeyupdate merge="delete" />
				<script>
					function onValueChanged()
						super.onValueChanged();
						if window.content and window.content.subwindow and window.content.subwindow.content_skills and window.content.subwindow.content_skills.subwindow then
							local wSkillsMain = window.content.subwindow.content_skills.subwindow;
							if wSkillsMain.filter then
								wSkillsMain.filter.setValue(getValue());
							end
						end
					end
				</script>
			</filter_list_content_controls>

			<sub_content_top name="content_stats">
				<class>charsheet_stats_main</class>
			</sub_content_top>

			<sub_content name="content_skills">
				<class>charsheet_skills_main</class>
			</sub_content>
		</sheetdata>
	</windowclass>

	<windowclass name="charsheet_skills_main">
