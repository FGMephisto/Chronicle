	<windowclass name="charsheet_skilllist_item">
		<margins control="0,0,0,2" />
		<script file="campaign/scripts/char_skill_chronicle.lua" />
		<sheetdata>
			<anchor_listitem_left_sm />
			<anchor_listitem_right_sm />

			<hsc name="stat_filter">
				<script>
					function onInit()
						setValue(DB.getValue(window.getDatabaseNode(), "stat", ""))
					end
				</script>
			</hsc>

			<button_listitem_idelete_left name="idelete" />
			<spacer_listitem_idelete_left name="idelete_spacer" />

			<button_listitem_left name="shortcut">
				<icon normal="button_link" />
				<script>
					function onButtonPress()
						window.openSkillLink();
					end
				</script>
			</button_listitem_left>

			<dicecontrol name="diceframe">
				<anchored to="rightanchor">
					<top offset="-6" />
					<right anchor="left" relation="relative" offset="-7" />
				</anchored>
				<stat></stat>
				<skill></skill>
				<actorpath>...</actorpath>
				<script>
					function onInit()
						local nodeSkill = window.getDatabaseNode()
						self.stat[1] = DB.getValue(nodeSkill, "stat", "")
						self.skill[1] = DB.getValue(nodeSkill, "name", "")
						super.onInit()
					end
				</script>
			</dicecontrol>

			<button_listitem_roll_right name="button_roll_skill">
				<script>
					function onDragStart(button, x, y, draginfo)
						return window.action(draginfo);
					end
					function onButtonPress()
						return window.action();
					end
				</script>
			</button_listitem_roll_right>

			<number_charskill name="misc">
				<script>
					function onValueChanged()
						-- Re-run the dicefield onInit to populate Ability and Skill values to the control required
						window.diceframe.onInit()
					end
				</script>
				<tabtarget prev="stat" />
			</number_charskill>
			<cycler_charskillability name="stat">
				<script>
					function onValueChanged()
						sAbility = DB.getValue(window.getDatabaseNode(), "stat", "")
						-- Set "stat_filter" so the skill will show/hide on filter set
						window.stat_filter.setValue(sAbility)
						-- Re-run the dicefield onInit to populate Ability and Skill values to the control required
						window.diceframe.onInit()
					end
				</script>
				<tabtarget next="misc" prev="name" />
			</cycler_charskillability>
			<icon_listitem_right name="armorwidget">
				<icon>char_armorcheck</icon>
				<invisible />
			</icon_listitem_right>
			
			<string_listitem_center_noframe_static name="name" />
		</sheetdata>
	</windowclass>

