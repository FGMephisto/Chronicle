<root>
	<windowclass name="reference_feat" copy="record_window" />
	<windowclass name="reference_feat_header" copy="record_header" />

	<windowclass name="reference_feat_main">
		<margins control="0,0,0,2" />
		<script>
			function onInit()
				update();
			end
			function update()
				local bReadOnly = WindowManager.getReadOnlyState(getDatabaseNode());
				WindowManager.callSafeControlsUpdate(self, { "type", "subtype", "requirements", "text" }, bReadOnly);
			end
		</script>
		<sheetdata>
			<anchor_content_top />
			
			<label_content_column name="type_label">
				<static textres="ref_feat_type_label" />
			</label_content_column>
			<string_content_columnh name="type" />

			<label_content_column name="subtype_label">
				<static textres="ref_feat_subtype_label" />
			</label_content_column>
			<string_content_columnh name="subtype" />

			<label_content_column name="requirements_label">
				<static textres="ref_feat_requirements_label" />
			</label_content_column>
			<string_content_columnh name="requirements" />

			<ft_content_columnh_full name="text" />
		</sheetdata>
	</windowclass>
</root>