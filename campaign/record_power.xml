					end
				</script>
			</button_listitem_text_right>
		</sheetdata>
	</windowclass>

	<windowclass name="power_choice">
		<frame>utilitybox</frame>
		<sizelimits>
			<minimum width="320" height="320" />
			<dynamic />
		</sizelimits>
		<script>
			function setData(rActor, tData)
				content.subwindow.setData(rActor, tData);
			end
		</script>
		<sheetdata>
			<windowmenubar_utilitybox name="menubar" />

			<anchor_content_utilitybox_top />
			<anchor_content_utilitybox_bottom />

			<sub_content_framed_groupbox name="content">
				<class>power_choice_content</class>
			</sub_content_framed_groupbox>
			<scrollbar_content />

			<resize_utilitybox />
		</sheetdata>
	</windowclass>
	<windowclass name="power_choice_content">
		<margins control="0,0,0,2" />
		<script file="campaign/scripts/power_choice.lua" />
		<sheetdata>
			<anchor_content_top />
			
			<header_content_framed_headersimple name="list_header">
				<static textres="power_choice_header" />
			</header_content_framed_headersimple>

			<area_content_top name="area_spell">
				<anchored height="30" />
			</area_content_top>
			<linkcontrol_record name="link">
				<anchored to="area_spell" position="insidetopleft" offset="5,5" width="20" height="20" />
			</linkcontrol_record>
			<label name="name">
				<anchored to="area_spell" position="insidetopleft" offset="30,5" />
			</label>

			<anchor_listitem_right>
				<anchored offset="0,65" />
			</anchor_listitem_right>
			<button_listitem_icon_right name="cancel">
				<state icon="button_toolbar_window_close" tooltipres="button_dialog_cancel" />
				<script>
					function onButtonPress()
						WindowManager.callOuterWindowFunction(window, "processCancel");
					end
				</script>
			</button_listitem_icon_right>
			<button_listitem_icon_right name="accept">
				<state icon="button_toolbar_accept" tooltipres="button_dialog_ok" />
				<script>
					function onButtonPress()
						WindowManager.callOuterWindowFunction(window, "processAccept");
					end
				</script>
			</button_listitem_icon_right>

			<list_content_top name="list">
				<anchored>
					<right parent="rightanchor" relation="current" />
					<sizelimits><minimum height="30" /></sizelimits>
				</anchored>
				<class>power_choice_item</class>
				<columns width="110" fillwidth="true" />
			</list_content_top>
		</sheetdata>
	</windowclass>
	<windowclass name="power_choice_item">
		<margins control="0,0,5,5" />
		<script>
			local _sChoice;
			function setData(s)
				_sChoice = s;
				button.setStateText(0, StringManager.capitalizeAll(_sChoice));
			end
			function onButtonPress()
				if button.getValue() == 1 then
					WindowManager.callOuterWindowFunction(windowlist, "addChoice", _sChoice);
				else
					WindowManager.callOuterWindowFunction(windowlist, "removeChoice", _sChoice);
				end
			end
		</script>
		<sheetdata>
			<button_text_toggle name="button">
				<anchored position="insidetop" offset="-5,5" />
				<script>
					function onButtonPress()
						window.onButtonPress();
					end
				</script>
			</button_text_toggle>
		</sheetdata>
	</windowclass>
</root>
