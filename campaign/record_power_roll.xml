		</sheetdata>
	</windowclass>

	<template name="sub_action_editor_scale_entry">
		<subwindow name="sub_scale">
			<anchored position="insidetop" offset="0,24" />
			<script>
				function onInit()
					self.updateDisplay();
				end
				function updateDisplay()
					local nodeAction = DB.getChild(window.getDatabaseNode(), "...");
					local nodePower = DB.getChild(nodeAction, "...");
					local nodePowerList = DB.getChild(nodePower, "..");
					if StringManager.contains({ "spell", "spelldata", "powers", "spells", "innatespells", }, DB.getName(nodePowerList)) then
						setValue("power_action_editor_scale_entry", window.getDatabasePath());
						setVisible(true);
					else
						setValue("", "");
						setVisible(false);
					end
				end
			</script>
		</subwindow>
	</template>
