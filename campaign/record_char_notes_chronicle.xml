<root>
	<windowclass name="charsheet_notes">
		<sheetdata>
			<anchor_content_top />
			<anchor_content_bottom />

			<sub_content_framed_groupbox name="content">
				<class>charsheet_notes_contents</class>
			</sub_content_framed_groupbox>
			<scrollbar_content />
		</sheetdata>
	</windowclass>

	<windowclass name="charsheet_notes_contents">
		<margins control="0,0,0,2" />
		<sheetdata>
			<anchor_content_top />

			<sub_content_top name="details">
				<class>charsheet_notes_details</class>
			</sub_content_top>

			<sub_content_top name="destiny">
				<class>charsheet_notes_destiny</class>
			</sub_content_top>

			<header_content_framed_metalplate name="appearance_header">
				<static textres="char_label_appearance" />
			</header_content_framed_metalplate>
			<stringu_content_noframe_noscroll_top name="appearance">
				<anchored>
					<left offset="10" />
					<right offset="-10" />
				</anchored>
			</stringu_content_noframe_noscroll_top>

			<header_content_framed_metalplate name="notes_header">
				<static textres="char_label_notes" />
			</header_content_framed_metalplate>
			<stringu_content_noframe_noscroll_top name="notes">
				<anchored>
					<left offset="10" />
					<right offset="-10" />
				</anchored>
			</stringu_content_noframe_noscroll_top>

			<header_content_framed_metalplate name="allies_header">
				<static textres="char_label_allies" />
			</header_content_framed_metalplate>
			<stringu_content_noframe_noscroll_top name="allies">
				<anchored>
					<left offset="10" />
					<right offset="-10" />
				</anchored>
			</stringu_content_noframe_noscroll_top>

			<header_content_framed_metalplate name="history_header">
				<static textres="char_label_history" />
			</header_content_framed_metalplate>
			<stringu_content_noframe_noscroll_top name="history">
				<anchored>
					<left offset="10" />
					<right offset="-10" />
				</anchored>
			</stringu_content_noframe_noscroll_top>
		</sheetdata>
	</windowclass>

	<windowclass name="charsheet_notes_details">
		<sheetdata>
			<anchor_content_top />

			<header_content_framed_metalplate name="details_header" />
			<area_content_top name="details">
				<anchored height="20" />
			</area_content_top>
			<stringu name="ancestry">
				<anchored to="details" position="insidetopleft" offset="10,0" width="80" height="20" />
				<center />
			</stringu>
			<stringu name="gender">
				<anchored to="ancestry" position="righthigh" offset="10,0" width="70" height="20" />
			</stringu>
			<stringu name="age">
				<anchored to="gender" position="righthigh" offset="10,0" width="70" height="20" />
			</stringu>
			<stringu name="height">
				<anchored to="age" position="righthigh" offset="10,0" width="70" height="20" />
			</stringu>
			<stringu name="size">
				<anchored to="height" position="righthigh" offset="10,0" width="70" height="20" />
			</stringu>
			<label_charfieldtop>
				<anchored to="ancestry" offset="0,3" />
				<static textres="char_label_ancestry" />
			</label_charfieldtop>
			<label_charfieldtop>
				<anchored to="gender" offset="0,3" />
				<static textres="char_label_gender" />
			</label_charfieldtop>
			<label_charfieldtop>
				<anchored to="age" offset="0,3" />
				<static textres="char_label_age" />
			</label_charfieldtop>
			<label_charfieldtop>
				<anchored to="height" offset="0,3" />
				<static textres="char_label_height" />
			</label_charfieldtop>
			<label_charfieldtop>
				<anchored to="size" offset="0,3" />
				<static textres="char_label_size" />
			</label_charfieldtop>
		</sheetdata>
	</windowclass>

	<windowclass name="charsheet_notes_destiny">
		<sheetdata>
			<anchor_content_top />

			<header_content_framed_metalplate name="destiny_header">
				<static textres="char_label_notes_destiny" />
			</header_content_framed_metalplate>

			<area_content_top name="dp_area">
				<anchored height="20">
					<top relation="relative" offset="16" postoffset="5" />
				</anchored>
			</area_content_top>
			<label name="label_dp">
				<anchored to="dp_area" position="insidetopleft" offset="5,0" width="100" height="20" />
				<static textres="char_label_dp" />
			</label>
			<number_chartotaldp name="dpremaining" source="destiny.dp.remaining">
				<anchored to="label_dp" position="righthigh" offset="5,0" width="45" height="20" />
				<readonly />
			</number_chartotaldp>
			<label_fieldtop>
				<anchored to="dpremaining" />
				<static textres="char_label_dp_available" />
			</label_fieldtop>
			<label name="dp_eq">
				<anchored to="dpremaining" position="righthigh" offset="3,0" width="10" height="20" />
				<static>=</static>
				<center />
			</label>
			<basicnumber name="dpbase" source="destiny.dp.base">
				<anchored to="dp_eq" position="righthigh" offset="3,0" width="45" height="20" />
			</basicnumber>
			<label_fieldtop>
				<anchored to="dpbase" />
				<static textres="char_label_dp_base" />
			</label_fieldtop>
			<label name="dp_plus">
				<anchored to="dpbase" position="righthigh" offset="3,0" width="10" height="20" />
				<static>+</static>
				<center />
			</label>
			<number_dropadd name="dpawarded" source="destiny.dp.awarded">
				<anchored to="dp_plus" position="righthigh" offset="3,0" width="45" height="20" />
			</number_dropadd>
			<label_fieldtop>
				<anchored to="dpawarded" />
				<static textres="char_label_dp_awarded" />
			</label_fieldtop>
			<label name="dp_minus1">
				<anchored to="dpawarded" position="righthigh" offset="3,0" width="10" height="20" />
				<static>-</static>
				<center />
			</label>
			<number_dropadd name="dpinvested" source="destiny.dp.invested">
				<anchored to="dp_minus1" position="righthigh" offset="3,0" width="45" height="20" />
			</number_dropadd>
			<label_fieldtop>
				<anchored to="dpinvested" />
				<static textres="char_label_dp_invested" />
			</label_fieldtop>
			<label name="dp_minus2">
				<anchored to="dpinvested" position="righthigh" offset="3,0" width="10" height="20" />
				<static>-</static>
				<center />
			</label>
			<number_dropadd name="dpburned" source="destiny.dp.burned">
				<anchored to="dp_minus2" position="righthigh" offset="3,0" width="45" height="20" />
			</number_dropadd>
			<label_fieldtop>
				<anchored to="dpburned" />
				<static textres="char_label_dp_burned" />
			</label_fieldtop>
			<label name="dp_minus3">
				<anchored to="dpburned" position="righthigh" offset="3,0" width="10" height="20" />
				<static>-</static>
				<center />
			</label>
			<number_dropadd name="dpspent" source="destiny.dp.spent">
				<anchored to="dp_minus3" position="righthigh" offset="3,0" width="45" height="20" />
			</number_dropadd>
			<label_fieldtop>
				<anchored to="dpspent" />
				<static textres="char_label_dp_spent" />
			</label_fieldtop>

			<area_content_top name="sp_area">
				<anchored height="20">
					<top relation="relative" offset="16" postoffset="5" />
				</anchored>
			</area_content_top>
			<label name="label_sp">
				<anchored to="sp_area" position="insidetopleft" offset="5,0" width="100" height="20" />
				<static textres="char_label_sp" />
			</label>
			<number_chartotalsp name="spremaining" source="destiny.sp.remaining">
				<anchored to="label_sp" position="righthigh" offset="5,0" width="45" height="20" />
				<readonly />
			</number_chartotalsp>
			<label_fieldtop>
				<anchored to="spremaining" />
				<static textres="char_label_sp_available" />
			</label_fieldtop>
			<label name="sp_eq">
				<anchored to="spremaining" position="righthigh" offset="3,0" width="10" height="20" />
				<static>=</static>
				<center />
			</label>
			<number_dropadd name="spawarded" source="destiny.sp.awarded">
				<anchored to="sp_eq" position="righthigh" offset="3,0" width="45" height="20" />
			</number_dropadd>
			<label_fieldtop>
				<anchored to="spawarded" />
				<static textres="char_label_sp_awarded" />
			</label_fieldtop>
			<label name="sp_minus1">
				<anchored to="spawarded" position="righthigh" offset="3,0" width="10" height="20" />
				<static>-</static>
				<center />
			</label>
			<number_dropadd name="spinvested" source="destiny.sp.invested">
				<anchored to="sp_minus1" position="righthigh" offset="3,0" width="45" height="20" />
			</number_dropadd>
			<label_fieldtop>
				<anchored to="spinvested" />
				<static textres="char_label_sp_invested" />
			</label_fieldtop>
			<label name="sp_minus2">
				<anchored to="spinvested" position="righthigh" offset="3,0" width="10" height="20" />
				<static>-</static>
				<center />
			</label>
			<number_dropadd name="spburned" source="destiny.sp.burned">
				<anchored to="sp_minus2" position="righthigh" offset="3,0" width="45" height="20" />
			</number_dropadd>
			<label_fieldtop>
				<anchored to="spburned" />
				<static textres="char_label_sp_burned" />
			</label_fieldtop>

			<area_content_top name="xp_area">
				<anchored height="20">
					<top relation="relative" offset="16" postoffset="5" />
				</anchored>
			</area_content_top>
			<label name="label_xp">
				<anchored to="xp_area" position="insidetopleft" offset="5,0" width="100" height="20" />
				<static textres="char_label_xp" />
			</label>
			<number_chartotalxp name="xpremaining" source="destiny.xp.remaining">
				<anchored to="label_xp" position="righthigh" offset="5,0" width="45" height="20" />
				<readonly />
			</number_chartotalxp>
			<label_fieldtop>
				<anchored to="xpremaining" />
				<static textres="char_label_xp_available" />
			</label_fieldtop>
			<label name="xp_eq">
				<anchored to="xpremaining" position="righthigh" offset="3,0" width="10" height="20" />
				<static>=</static>
				<center />
			</label>
			<number_dropadd name="xpawarded" source="destiny.xp.awarded">
				<anchored to="xp_eq" position="righthigh" offset="3,0" width="45" height="20" />
			</number_dropadd>
			<label_fieldtop>
				<anchored to="xpawarded" />
				<static textres="char_label_xp_awarded" />
			</label_fieldtop>
			<label name="xp_minus1">
				<anchored to="xpawarded" position="righthigh" offset="3,0" width="10" height="20" />
				<static>-</static>
				<center />
			</label>
			<number_dropadd name="xpinvested" source="destiny.xp.invested">
				<anchored to="xp_minus1" position="righthigh" offset="3,0" width="45" height="20" />
			</number_dropadd>
			<label_fieldtop>
				<anchored to="xpinvested" />
				<static textres="char_label_xp_invested" />
			</label_fieldtop>
		</sheetdata>
	</windowclass>
</root>
